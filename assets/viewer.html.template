<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{VIEWER_TITLE}}</title>
<!-- ponytail: CDN libs; bundle locally when offline required -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.29.2/cytoscape.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/dagre/0.8.5/dagre.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/cytoscape-dagre@2.5.0/cytoscape-dagre.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#0f172a;color:#e2e8f0;height:100vh;display:flex;flex-direction:column;overflow:hidden}
header{padding:10px 16px;background:#1e293b;border-bottom:1px solid #334155;display:flex;align-items:center;gap:16px;flex-shrink:0;flex-wrap:wrap}
h1{font-size:14px;font-weight:700;color:#f8fafc;letter-spacing:.5px}
.legend{display:flex;gap:10px;margin-left:8px;flex-wrap:wrap}
.li{display:flex;align-items:center;gap:5px;font-size:11px;color:#94a3b8}
.dot{width:9px;height:9px;border-radius:2px}
.dot-M{background:#f97316}.dot-A{background:#22c55e}.dot-R{background:#ef4444}
.dot-I{border:1px dashed #fbbf24}.dot-out{background:#22d3ee}.dot-in{background:#fb923c}
.li-edge{display:flex;align-items:center;gap:5px;font-size:11px;color:#475569}
.edge-line{width:16px;height:2px}
.edge-out{background:#22d3ee}.edge-in{background:#fb923c}
#stats{margin-left:auto;font-size:11px;color:#64748b}
#hint{position:absolute;top:46px;left:50%;transform:translateX(-50%);font-size:11px;color:#475569;pointer-events:none;transition:opacity .3s}
#cy{flex:1;background:#0f172a}
/* Group toggle */
#group-toggle{display:flex;align-items:center;gap:5px;font-size:11px;color:#64748b;cursor:pointer;user-select:none}
#group-toggle input{cursor:pointer;accent-color:#6366f1}
/* Right panel */
#panel{position:fixed;right:0;top:0;bottom:0;width:480px;min-width:260px;max-width:90vw;background:#1e293b;border-left:2px solid #334155;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .18s ease;z-index:50}
#panel.open{transform:translateX(0)}
#panel-resize{position:absolute;left:0;top:0;bottom:0;width:6px;cursor:col-resize;z-index:52;background:transparent;transition:background .15s}
#panel-resize:hover,#panel-resize.dragging{background:rgba(99,102,241,.35)}
#ph{padding:10px 14px;background:#0f172a;border-bottom:1px solid #334155;display:flex;align-items:center;gap:8px;flex-shrink:0}
#pt{font-size:12px;font-weight:600;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#f1f5f9}
.badge{font-size:10px;padding:2px 6px;border-radius:3px;font-weight:700;text-transform:uppercase;flex-shrink:0}
.b-MODIFIED{background:#f97316;color:#fff}.b-ADDED{background:#22c55e;color:#fff}
.b-REMOVED{background:#ef4444;color:#fff}.b-UNCHANGED{background:#475569;color:#fff}
#pc{font-size:11px;color:#94a3b8;padding:4px 14px;background:#0f172a;border-bottom:1px solid #1e293b;flex-shrink:0}
#pb{flex:1;overflow-y:auto}
.close-btn{cursor:pointer;color:#64748b;font-size:20px;line-height:1;padding:2px 6px;border-radius:4px}
.close-btn:hover{color:#f1f5f9;background:#334155}
.member-item{padding:6px 14px;cursor:pointer;border-bottom:1px solid #1e293b;display:flex;align-items:center;gap:6px}
.member-item:hover{background:#263548}
.member-item .badge{flex-shrink:0}
.member-sig{font-size:11px;color:#cbd5e1;font-family:'Fira Code',monospace;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.code-block{background:#0f172a;padding:12px 14px;overflow-x:auto}
.code-block pre{margin:0}
.diff-wrap{padding:8px 0}
.dl{padding:1px 14px;white-space:pre;font-family:'Fira Code',Consolas,monospace;font-size:11px;line-height:1.55}
.dl-added{background:rgba(34,197,94,.1);color:#86efac}.dl-added::before{content:'+\00a0';color:#22c55e}
.dl-removed{background:rgba(239,68,68,.1);color:#fca5a5}.dl-removed::before{content:'-\00a0';color:#ef4444}
.dl-unchanged{color:#64748b}.dl-unchanged::before{content:'\00a0\00a0'}
.sep{height:1px;background:#334155;margin:4px 0}
/* Relations section in panel */
#rel-section{padding:8px 14px 12px;border-top:1px solid #1e293b}
#rel-section h3{font-size:10px;color:#475569;text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px}
.rel-item{display:flex;align-items:center;gap:6px;padding:3px 0;font-size:11px;cursor:pointer}
.rel-item:hover{color:#f1f5f9}
.rel-arrow{font-size:13px;flex-shrink:0}
.rel-out{color:#22d3ee}.rel-in{color:#fb923c}
.rel-name{color:#94a3b8;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rel-type{font-size:10px;color:#475569;flex-shrink:0}
</style>
</head>
<body>
<header>
  <h1>{{VIEWER_TITLE}}</h1>
  <div class="legend">
    <div class="li"><div class="dot dot-M"></div>Modified</div>
    <div class="li"><div class="dot dot-A"></div>Added</div>
    <div class="li"><div class="dot dot-R"></div>Removed</div>
    <div class="li"><div class="dot dot-I"></div>Impacted</div>
    <div class="li" style="margin-left:8px;color:#334155">|</div>
    <div class="li-edge"><div class="edge-line edge-out"></div>outgoing</div>
    <div class="li-edge"><div class="edge-line edge-in"></div>incoming</div>
  </div>
  <label id="group-toggle"><input type="checkbox" id="grouping-cb" checked> Group by domain</label>
  <div id="stats"></div>
</header>
<div id="hint">Click a class to see its connections</div>
<div id="cy"></div>

<div id="panel">
  <div id="panel-resize"></div>
  <div id="ph">
    <div id="pt"></div>
    <span class="badge" id="pb-badge"></span>
    <span class="close-btn" id="close">&times;</span>
  </div>
  <div id="pc"></div>
  <div id="pb"></div>
</div>

<script>
const GRAPH = {{GRAPH_DATA}};
const INDEX = {{CODE_INDEX_DATA}};

const COLORS  = {MODIFIED:'#f97316',ADDED:'#22c55e',REMOVED:'#ef4444',UNCHANGED:'#1e293b'};
const BORDERS = {MODIFIED:'#fb923c',ADDED:'#4ade80',REMOVED:'#f87171',UNCHANGED:'#334155'};

function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}

// Build node lookup: id → data
const nodeById = {};
GRAPH.nodes.forEach(n => nodeById[n.data.id] = n.data);

function renderCode(entry){
  if(!entry) return '<div style="padding:20px;color:#64748b">No data</div>';
  if(entry.diffLines && entry.diffLines.length){
    return '<div class="diff-wrap">' + entry.diffLines.map(dl =>
      `<div class="dl dl-${dl.type}">${esc(dl.text)}</div>`
    ).join('') + '</div>';
  }
  const lang = entry.language || 'plaintext';
  return `<div class="code-block"><pre><code class="language-${lang}">${esc(entry.fullCode)}</code></pre></div>`;
}

function renderMemberList(nodeData){
  const methods = nodeData.methods || [];
  const props = nodeData.properties || [];
  let html = '';

  if(props.length){
    html += '<div style="padding:6px 14px 2px;font-size:10px;color:#475569;text-transform:uppercase;letter-spacing:.8px">Properties</div>';
    props.forEach(p => {
      const sig = `${p.visibility}${p.isStatic?' static':''} ${p.type||''} $${p.name}`;
      html += `<div class="member-item" data-id="${p.id}">
        <span class="badge b-${p.changeType}">${p.changeType[0]}</span>
        <span class="member-sig">${esc(sig)}</span>
      </div>`;
      if(INDEX[p.id] && p.changeType !== 'UNCHANGED')
        html += `<div id="code-${p.id}" style="display:none">${renderCode(INDEX[p.id])}</div>`;
    });
    html += '<div class="sep"></div>';
  }

  if(methods.length){
    html += '<div style="padding:6px 14px 2px;font-size:10px;color:#475569;text-transform:uppercase;letter-spacing:.8px">Methods</div>';
    methods.forEach(m => {
      const params = (m.parameters||[]).join(', ');
      const ret = m.returnType ? ': '+m.returnType : '';
      const sig = `${m.visibility}${m.isStatic?' static':''}${m.isAbstract?' abstract':''} ${m.name}(${params})${ret}`;
      html += `<div class="member-item" data-id="${m.id}">
        <span class="badge b-${m.changeType}">${m.changeType[0]}</span>
        <span class="member-sig">${esc(sig)}</span>
      </div>`;
      if(INDEX[m.id])
        html += `<div id="code-${m.id}" style="display:none">${renderCode(INDEX[m.id])}</div>`;
    });
  }

  return html || '<div style="padding:16px;color:#475569">No members</div>';
}

function renderRelations(nodeId){
  const outEdges = GRAPH.edges.filter(e => e.data.source === nodeId);
  const inEdges  = GRAPH.edges.filter(e => e.data.target === nodeId);
  if(!outEdges.length && !inEdges.length) return '';

  let html = '<div id="rel-section"><h3>Relations</h3>';

  outEdges.forEach(e => {
    const target = nodeById[e.data.target];
    if(!target) return;
    html += `<div class="rel-item" data-goto="${e.data.target}">
      <span class="rel-arrow rel-out">→</span>
      <span class="rel-name">${esc(target.label)}</span>
      <span class="rel-type">${e.data.type}</span>
    </div>`;
  });

  inEdges.forEach(e => {
    const src = nodeById[e.data.source];
    if(!src) return;
    html += `<div class="rel-item" data-goto="${e.data.source}">
      <span class="rel-arrow rel-in">←</span>
      <span class="rel-name">${esc(src.label)}</span>
      <span class="rel-type">${e.data.type}</span>
    </div>`;
  });

  return html + '</div>';
}

function openPanel(nodeData){
  document.getElementById('pt').textContent = nodeData.fqcn || nodeData.label;
  const badge = document.getElementById('pb-badge');
  badge.textContent = nodeData.changeType;
  badge.className = 'badge b-' + nodeData.changeType;

  const hint = nodeData.isImpacted ? ('⚠ impacted by ' + nodeData.impactReason) : '';
  document.getElementById('pc').textContent = hint || (nodeData.filePath || '').replace(/.*\/app\//, 'app/');

  const body = document.getElementById('pb');
  body.innerHTML = renderMemberList(nodeData) + renderRelations(nodeData.id);

  body.querySelectorAll('.member-item').forEach(item => {
    item.addEventListener('click', () => {
      const id = item.dataset.id;
      let block = document.getElementById('code-' + id);
      if(!block){
        const entry = INDEX[id];
        if(!entry) return;
        block = document.createElement('div');
        block.id = 'code-' + id;
        block.innerHTML = renderCode(entry);
        item.insertAdjacentElement('afterend', block);
        block.querySelectorAll('pre code').forEach(el => hljs.highlightElement(el));
        return;
      }
      const hidden = block.style.display === 'none';
      block.style.display = hidden ? '' : 'none';
      if(hidden) block.querySelectorAll('pre code').forEach(el => hljs.highlightElement(el));
    });
  });

  // Click on relation item → focus that node
  body.querySelectorAll('.rel-item[data-goto]').forEach(item => {
    item.addEventListener('click', () => {
      const node = cy.getElementById(item.dataset.goto);
      if(node.length) { cy.animate({fit:{eles:node,padding:80}},{duration:300}); selectNode(node); }
    });
  });

  document.getElementById('panel').classList.add('open');
  document.getElementById('hint').style.opacity = '0';
}

// Stats
const classNodes = GRAPH.nodes.filter(n => !n.data.isDomain);
const domainNodes = GRAPH.nodes.filter(n => n.data.isDomain);
const changed = classNodes.filter(n=>n.data.changeType!=='UNCHANGED').length;
const impacted = classNodes.filter(n=>n.data.isImpacted).length;
document.getElementById('stats').textContent =
  `${classNodes.length} classes · ${domainNodes.length} domains · ${changed} changed · ${impacted} impacted`;

// Build Cytoscape elements — with or without parent grouping
function buildElements(grouped){
  const nodes = grouped
    ? GRAPH.nodes.map(n => ({group:'nodes', data:n.data}))
    : GRAPH.nodes
        .filter(n => !n.data.isDomain)
        .map(n => {
          const d = {...n.data};
          delete d.parent;
          return {group:'nodes', data:d};
        });
  // In flat mode exclude domain-level edges (no parent nodes to attach to)
  const edges = GRAPH.edges
    .filter(e => grouped || !e.data.isDomainEdge)
    .map(e => ({group:'edges', data:e.data}));
  return [...nodes, ...edges];
}

// Cytoscape
const cy = cytoscape({
  container: document.getElementById('cy'),
  elements: buildElements(true),
  style: [
    // Domain compound nodes
    {
      selector: 'node[?isDomain]',
      style: {
        'background-color': 'rgba(30,41,59,0.6)',
        'background-opacity': 1,
        'border-color': '#334155',
        'border-width': 1,
        'border-style': 'solid',
        'label': 'data(label)',
        'text-valign': 'top',
        'text-halign': 'center',
        'font-size': 11,
        'font-weight': 700,
        'color': '#94a3b8',
        'text-margin-y': -4,
        'padding': 20,
        'shape': 'roundrectangle',
        'text-background-color': '#0f172a',
        'text-background-opacity': 1,
        'text-background-padding': '3px',
        'text-border-color': '#334155',
        'text-border-width': 1,
        'text-border-opacity': 1,
      },
    },
    // Class nodes
    {
      selector: 'node[!isDomain]',
      style: {
        'background-color': n => COLORS[n.data('changeType')] || COLORS.UNCHANGED,
        'border-color': n => BORDERS[n.data('changeType')] || BORDERS.UNCHANGED,
        'border-width': n => n.data('changeType') !== 'UNCHANGED' ? 2 : 1,
        'label': n => {
          const visChar = {public:'+',protected:'#',private:'-'};
          let label = `«${n.data('type')}»\n${n.data('label')}`;
          const props = n.data('properties') || [];
          const methods = n.data('methods') || [];
          if(props.length){
            label += '\n─────';
            props.forEach(p => {
              const mark = p.changeType !== 'UNCHANGED' ? '● ' : '  ';
              label += `\n${mark}${visChar[p.visibility]||''}${p.type?' '+p.type:''} $${p.name}`;
            });
          }
          if(methods.length){
            label += '\n─────';
            methods.forEach(m => {
              const mark = m.changeType !== 'UNCHANGED' ? '● ' : '  ';
              label += `\n${mark}${visChar[m.visibility]||''}${m.name}()`;
            });
          }
          return label;
        },
        'text-valign': 'center',
        'text-halign': 'center',
        'font-family': "'Fira Code', Consolas, monospace",
        'font-size': 10,
        'text-wrap': 'wrap',
        'text-max-width': 220,
        'width': 'label',
        'height': 'label',
        'padding': 12,
        'shape': 'rectangle',
        'color': '#e2e8f0',
      },
    },
    { selector: 'node[!isDomain][?isImpacted]', style: {'border-color':'#eab308','border-width':2,'border-style':'dashed'} },
    { selector: 'node[!isDomain][changeType="REMOVED"]', style: {'background-color':'#1a0a0a','border-color':'#ef4444','border-width':2,'border-style':'dashed'} },

    // Domain edges — always visible, thin structural lines
    {
      selector: 'edge[?isDomainEdge]',
      style: {
        'opacity': 0.55,
        'width': 1.5,
        'line-color': '#475569',
        'target-arrow-color': '#475569',
        'target-arrow-shape': 'vee',
        'arrow-scale': 1,
        'curve-style': 'bezier',
        'label': e => String(e.data('count')),
        'font-size': 9,
        'color': '#64748b',
        'text-background-color': '#0f172a',
        'text-background-opacity': 1,
        'text-background-padding': '2px',
      },
    },
    // Class-level edges — hidden by default, shown only on node selection
    {
      selector: 'edge[!isDomainEdge]',
      style: {
        'opacity': 0,
        'width': 0,
        'curve-style': 'bezier',
        'target-arrow-shape': 'none',
      },
    },
    // Outgoing edge from selected node (→)
    {
      selector: 'edge.edge-out',
      style: {
        'opacity': 1,
        'width': 2,
        'line-color': '#22d3ee',
        'target-arrow-color': '#22d3ee',
        'target-arrow-shape': e => e.data('type') === 'extends' ? 'triangle' : 'vee',
        'line-style': e => e.data('type') === 'implements' ? 'dashed' : 'solid',
        'curve-style': 'unbundled-bezier',
        'control-point-distances': [40],
        'control-point-weights': [0.5],
        'arrow-scale': 1.3,
        'z-index': 20,
      },
    },
    // Incoming edge to selected node (←)
    {
      selector: 'edge.edge-in',
      style: {
        'opacity': 1,
        'width': 2,
        'line-color': '#fb923c',
        'target-arrow-color': '#fb923c',
        'target-arrow-shape': e => e.data('type') === 'extends' ? 'triangle' : 'vee',
        'line-style': e => e.data('type') === 'implements' ? 'dashed' : 'solid',
        'curve-style': 'unbundled-bezier',
        'control-point-distances': [40],
        'control-point-weights': [0.5],
        'arrow-scale': 1.3,
        'z-index': 20,
      },
    },
    // Dim unrelated nodes when a selection is active
    { selector: 'node.dimmed', style: {'opacity': 0.2} },
    { selector: 'node[!isDomain].focused', style: {'border-color':'#818cf8','border-width':3} },
  ],
  layout: {name:'dagre', rankDir:'TB', nodeSep:40, rankSep:80, padding:30, compound:true},
  minZoom: 0.05,
  maxZoom: 4,
});

function selectNode(node){
  // Clear previous
  cy.elements().removeClass('edge-out edge-in dimmed focused');

  // Highlight outgoing / incoming class-level edges only
  node.outgoers('edge[!isDomainEdge]').addClass('edge-out');
  node.incomers('edge[!isDomainEdge]').addClass('edge-in');

  // Dim class nodes not directly connected; keep domain nodes and domain edges visible
  const connected = node
    .union(node.outgoers('edge[!isDomainEdge]').targets())
    .union(node.incomers('edge[!isDomainEdge]').sources());
  cy.nodes('[!isDomain]').not(connected).addClass('dimmed');
  node.addClass('focused');

  openPanel(node.data());
}

cy.on('tap', 'node', evt => {
  const node = evt.target;
  // Domain compound node: just zoom to it, don't open panel
  if(node.data('isDomain')){
    cy.elements().removeClass('edge-out edge-in dimmed focused');
    document.getElementById('panel').classList.remove('open');
    document.getElementById('hint').style.opacity = '1';
    cy.animate({fit:{eles:node,padding:40}},{duration:300});
    return;
  }
  selectNode(node);
});

cy.on('tap', evt => {
  if(evt.target !== cy) return;
  cy.elements().removeClass('edge-out edge-in dimmed focused');
  document.getElementById('panel').classList.remove('open');
  document.getElementById('hint').style.opacity = '1';
});

document.getElementById('close').addEventListener('click', () => {
  cy.elements().removeClass('edge-out edge-in dimmed focused');
  document.getElementById('panel').classList.remove('open');
  document.getElementById('hint').style.opacity = '1';
});

// Domain grouping toggle
document.getElementById('grouping-cb').addEventListener('change', e => {
  const grouped = e.target.checked;
  cy.elements().removeClass('edge-out edge-in dimmed focused');
  document.getElementById('panel').classList.remove('open');
  document.getElementById('hint').style.opacity = '1';

  cy.elements().remove();
  cy.add(buildElements(grouped));
  cy.layout({name:'dagre', rankDir:'TB', nodeSep:40, rankSep:80, padding:30, compound:grouped}).run();
});

// Panel resize drag
(function(){
  const panel = document.getElementById('panel');
  const handle = document.getElementById('panel-resize');
  const STORE_KEY = 'uml-panel-w';
  let dragging = false, startX = 0, startW = 0;

  const saved = localStorage.getItem(STORE_KEY);
  if (saved) panel.style.width = saved;

  handle.addEventListener('mousedown', e => {
    dragging = true; startX = e.clientX; startW = panel.offsetWidth;
    handle.classList.add('dragging');
    document.body.style.cssText += ';cursor:col-resize!important;user-select:none!important';
    e.preventDefault();
  });
  document.addEventListener('mousemove', e => {
    if (!dragging) return;
    const w = Math.max(260, Math.min(window.innerWidth * 0.9, startW + startX - e.clientX));
    panel.style.width = w + 'px';
  });
  document.addEventListener('mouseup', () => {
    if (!dragging) return;
    dragging = false;
    handle.classList.remove('dragging');
    document.body.style.cursor = '';
    document.body.style.userSelect = '';
    localStorage.setItem(STORE_KEY, panel.style.width);
  });
})();
</script>
</body>
