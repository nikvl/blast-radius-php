#!/usr/bin/env php
<?php

declare(strict_types=1);

// Try standalone install first, then piggyback on parent project's vendor
$loader = null;
foreach ([
    __DIR__ . '/../vendor/autoload.php',   // standalone: composer install inside this package
    __DIR__ . '/../../../autoload.php',     // inside a parent project's vendor/
] as $autoload) {
    if (file_exists($autoload)) {
        $loader = require $autoload;
        break;
    }
}

if ($loader === null) {
    fwrite(STDERR, "Error: no autoload.php found. Run composer install inside the package or install via composer.\n");
    exit(1);
}

// Register our namespace (needed when piggybacking on parent's vendor)
if (is_object($loader) && method_exists($loader, 'addPsr4')) {
    $loader->addPsr4('PhpUmlGenerator\\', __DIR__ . '/../src/');
}

use PhpUmlGenerator\Command\BaselineCommand;
use PhpUmlGenerator\Command\DiffCommand;
use Symfony\Component\Console\Application;

$app = new Application('php-uml-generator', '0.1.0');
$app->add(new BaselineCommand());
$app->add(new DiffCommand());
$app->run();
